#!/bin/zsh

# Codex emits ESC[0 q at startup, which makes JetBrains terminals blink
# even when caret blinking is disabled in the IDE settings. Send
# ESC[2 q after a one-second delay to select a steady block, then restore
# it on exit. The delay is a workaround: slower startup or later cursor
# changes from Codex can override it. Other terminals and redirected I/O
# run Codex directly.
emulate -L zsh
unsetopt bg_nice

if [[ $TERMINAL_EMULATOR != JetBrains-JediTerm || ! -t 0 || ! -t 1 ]]; then
  command codex "$@"
  return $?
fi

local cursor_job
local result
(
  sleep 1
  printf '\033[2 q'
) &!
cursor_job=$!

{
  command codex "$@"
  result=$?
} always {
  kill "$cursor_job" 2>/dev/null
  printf '\033[2 q'
}
return $result
